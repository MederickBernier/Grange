{
  "name": "@jyga/grange-react",
  "version": "0.1.0",
  "description": "Material 3 Expressive components for React, built from the M3E token spec",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./scss": "./dist/scss/index.scss",
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "tokens": "tsx scripts/build-tokens.mts",
    "typecheck": "pnpm tokens && tsc -p tsconfig.json --noEmit",
    "build": "pnpm tokens && vite build && tsc -p tsconfig.build.json && pnpm copy-scss",
    "copy-scss": "tsx scripts/copy-scss.mts",
    "capture-tokens": "tsx scripts/capture-tokens.mts",
    "test": "pnpm tokens && vitest run",
    "storybook": "pnpm tokens && storybook dev -p 6006",
    "build-storybook": "pnpm tokens && storybook build -o storybook-static",
    "capture-shapes": "tsx scripts/capture-shapes.mts"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "motion": "^12.23.0",
    "react-aria": "^3.43.0",
    "react-stately": "^3.50.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
